# ============================================================
#  IDS - Variables de entorno (SECRETOS)
#
#  1) Copia este archivo como .env:   cp .env.example .env
#  2) Rellena tus valores reales.
#  3) NUNCA subas el archivo .env a git (ya esta en .gitignore).
#
#  Aqui SOLO viven secretos. Los parametros no sensibles
#  (email del admin, subred, umbrales) estan en config/settings.yaml
# ============================================================

# --- SMTP: Mailtrap (sandbox de pruebas) ---
# Obten estos datos en:
#   Mailtrap > Email Testing > Inboxes > tu inbox > SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=cambia_esto
SMTP_PASSWORD=cambia_esto

# Destino y remitente de las alertas (opcional; vacio -> usa settings.yaml).
# Tambien se pueden cambiar desde el dashboard web.
ALERT_TO=
ALERT_FROM=

# --- Threat Intelligence ---
# API key gratuita de https://www.abuseipdb.com  (Account > API)
ABUSEIPDB_API_KEY=cambia_esto
